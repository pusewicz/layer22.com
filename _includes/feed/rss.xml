{%- comment -%}
RSS 2.0 channel for `include.items`. Untitled items (notes) omit <title>, and
items with a `link` get its card appended to their content.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ include.title | smartify | xml_escape }}</title>
    <link>{{ include.link | absolute_url }}</link>
    <atom:link href="{{ include.feed | absolute_url }}" rel="self" type="application/rss+xml" />
    <description>{{ include.description | strip_newlines | xml_escape }}</description>
    <language>{{ site.lang | default: 'en-US' }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% if site.author %}
    <managingEditor>{{ site.author.email }}{% if site.author.name %} ({{ site.author.name | xml_escape }}){% endif %}</managingEditor>
    <webMaster>{{ site.author.email }}{% if site.author.name %} ({{ site.author.name | xml_escape }}){% endif %}</webMaster>
    {% endif %}
    {% assign posts_limit = site.feed.posts_limit | default: 10 %}
    {% assign href_abs = 'href="' | append: site.url | append: '/' %}
    {% assign src_abs = 'src="' | append: site.url | append: '/' %}
    {% for post in include.items limit: posts_limit %}
    {% capture html %}{{ post.content }}{% if post.link.youtube %}{% include note/youtube.html link=post.link feed=true %}{% elsif post.link %}{% include note/link-card.html link=post.link %}{% endif %}{% endcapture %}
    {% assign text = html | strip_html | normalize_whitespace %}
    <item>
      {%- if post.title != blank %}
      <title>{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      {%- endif %}
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {% if post.author %}
      <dc:creator>{{ post.author | xml_escape }}</dc:creator>
      {% elsif site.author.name %}
      <dc:creator>{{ site.author.name | xml_escape }}</dc:creator>
      {% endif %}
      <description>{{ text | truncate: 400 | xml_escape }}</description>
      <content:encoded><![CDATA[{{ html | replace: 'href="/', href_abs | replace: 'src="/', src_abs | strip }}]]></content:encoded>
      {% for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
