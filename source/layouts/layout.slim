ruby:
  set_meta_tags title: current_page.data.title if current_page.data.title
  set_meta_tags keywords: current_page.data.meta_keywords if current_page.data.meta_keywords
  set_meta_tags description: current_page.data.meta_description if current_page.data.meta_description

doctype html
html
  head
    meta charset="utf-8"
    meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible"
    meta name="verify-v1" content="JjdOlxZo3cBrBYJiQ6Zdkr4vY2DUQAfTvbFMAdXch8Q="
    meta name="google-site-verification" content="CHhKMKbOqPlnAWNKhrQXx5_yRKQ6IGdLuKq6ZebfIOM"
    meta name="msvalidate.01" content="DF88F2F3151FD071CD779118E1837AE1"
    meta name="viewport" content="width=device-width,initial-scale=1"
    link rel="icon" href="/favicon.ico" type="image/x-icon"
    link rel="shortcut icon" href="/favicon.ico" type="image/x-icon"
    link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Atom Feed"

    = auto_display_meta_tags

    = stylesheet_link_tag "all"
    = javascript_include_tag  "all"

    - unless development?
      javascript:
        var _gaq=[['_setAccount','UA-9186590-1'],['_trackPageview']];
        (function(d,t){var g=d.createElement(t),s=d.getElementsByTagName(t)[0];g.async=1;
        g.src=('https:'==location.protocol?'//ssl':'//www')+'.google-analytics.com/ga.js';
        s.parentNode.insertBefore(g,s)}(document,'script'));

      javascript:
        (function() {
          var t = document.createElement('script');
          t.type = 'text/javascript'; t.async = true;
          t.id = 'gauges-tracker';
          t.setAttribute('data-site-id',
                         '4d6e45c886d56d27c1000039');
          t.src = 'http://track.gaug.es/track.js';
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(t, s);
        })();
  body class=page_classes
    = yield
    footer
      .row
        .small-10.small-centered.columns= partial 'layouts/footer'
